# Copy to .env and fill in. Never commit .env.

APP_NAME="Forever Service Board"
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (docker compose "postgres" service)
DATABASE_URL=postgresql+asyncpg://forever:forever@localhost:5433/forever
# Used by the test suite (docker compose "postgres-test" service)
TEST_DATABASE_URL=postgresql+asyncpg://forever:forever@localhost:5434/forever_test

# Web
FRONTEND_URL=http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me
TOKEN_ENCRYPTION_KEY=change-me

# Blizzard / Battle.net
# mock | live (live requires the four values below)
BLIZZARD_MODE=mock
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Forever namespaces are not published yet (spec §13.1)
BLIZZARD_PROFILE_NAMESPACE=
BLIZZARD_STATIC_NAMESPACE=
BLIZZARD_REGIONS=us,eu,kr,tw
OAUTH_REDIRECT_URL=http://localhost:8000/api/auth/battlenet/callback

# Listings (spec §6.7)
LISTING_LIFETIME_SUMMON_MINUTES=30
LISTING_LIFETIME_PORTAL_MINUTES=30
LISTING_LIFETIME_ENCHANT_MINUTES=1440
LISTING_LIFETIME_CRAFT_MINUTES=10080
INACTIVE_CHARACTER_DAYS=14
# Placeholders: {character_name} {service} {site_name} {price}
WHISPER_FORMAT="/w {character_name} Hi! I saw your {service} listing on {site_name} ({price})."
